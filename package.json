{
  "name": "kervan-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "Kervan — Spec-to-Quote prototype for small garment production runs (frontend only, demo data).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
